# --- AI provayder ---
# "gemini" (bepul, standart) yoki "anthropic" (pullik, agar keyinchalik kalit olsangiz)
AI_PROVIDER=gemini

# Gemini — bepul kalitni https://aistudio.google.com/apikey sahifasidan oling
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic — faqat AI_PROVIDER=anthropic bo'lsa kerak
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- MongoDB Atlas (ixtiyoriy) ---
# Bo'lmasa server ishlayveradi: AI so'rov limiti xotirada (restart'da tozalanadi)
# saqlanadi va progress backup/sync o'chirilgan bo'ladi (frontend localStorage'da ishlayveradi).
MONGODB_URI=
MONGODB_DB_NAME=yoldosh_ai

# --- Frontend manzili (CORS uchun) ---
CLIENT_ORIGIN=http://localhost:5173

# --- Server porti ---
PORT=8787
